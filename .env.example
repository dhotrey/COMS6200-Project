# Copy this file to .env at the repository root.
CLOUDFLARE_ACCOUNT_ID=
# Cloudflare account API token with D1 Write access (not the AI Gateway token).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_AI_GATEWAY_ID=
CLOUDFLARE_AI_GATEWAY_API_TOKEN=
# Optional alias of the OpenAI key stored in Cloudflare; blank uses default.
CLOUDFLARE_BYOK_ALIAS=
# Optional. Without this, Logfire export is disabled.
LOGFIRE_TOKEN=

# Reference lab ONOS REST (loopback). Override if you changed the container creds.
# These are never sent to the model. ping/iperf still need root for mnexec.
ONOS_USER=onos
ONOS_PASSWORD=rocks

# Protocol v1 measurement settings. Delays stay 0. The tool cap is 14.
TOOL_DELAY_MIN_SECONDS=0
TOOL_DELAY_MAX_SECONDS=0
MAX_TOOL_CALLS=14
MAX_TURN_SECONDS=300
# 0 disables the per-turn token stop. A positive value restores it.
MAX_TURN_TOKENS=0
